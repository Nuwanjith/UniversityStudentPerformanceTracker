@{
    ViewData["Title"] = "Predict Grade";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<h2>Predict Grade</h2>

<form asp-action="PredictGrade" method="post">
    <div class="form-group">
        <label for="subject">Subject:</label>
        <select id="subject" name="subject" class="form-control" required>
            @foreach (var subject in ViewBag.Subjects)
            {
                <option value="@subject">@subject</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label for="futureStudyHours">Future Study Hours:</label>
        <input type="number" id="futureStudyHours" name="futureStudyHours" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Predict</button>
</form>

@if (ViewBag.PredictedGrade != null)
{
    <h3>Predicted Grade: @ViewBag.PredictedGrade</h3>
}


