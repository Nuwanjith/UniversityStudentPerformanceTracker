@model UniversityStudentPerformanceTracker.Models.Break

@{
    ViewData["Title"] = "Create Breaks";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="dashboard-container">
    <h1>Create Break Session</h1>

    <form asp-controller="Break" asp-action="CreateBreak" method="post">
        <div class="form-group">
            <label asp-for="Date">Date:</label>
            <input asp-for="Date" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="StartTime">Start Time:</label>
            <input asp-for="StartTime" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="EndTime">End Time:</label>
            <input asp-for="EndTime" class="form-control" />
        </div>
        <div class="form-group">
            <label asp-for="Duration">Duration (Minutes):</label>
            <input asp-for="Duration" class="form-control" />
        </div>
        
        <button type="submit" class="btn btn-primary">Create</button>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
