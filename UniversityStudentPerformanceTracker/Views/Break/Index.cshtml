@model IEnumerable<UniversityStudentPerformanceTracker.Models.Break>

@{
    ViewData["Title"] = "Breaks";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="dashboard-container">
    <h1>Break Sessions</h1>

    <div>
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Duration (Minutes)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var breakSession in Model.OrderByDescending(b => b.Date))
                {
                    <tr>
                        <td>@breakSession.Date.ToShortDateString()</td>
                        <td>@breakSession.StartTime.ToShortTimeString()</td>
                        <td>@breakSession.EndTime.ToShortTimeString()</td>
                        <td>@breakSession.Duration</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@breakSession.BreakId" class="btn btn-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@breakSession.BreakId" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <a asp-action="Create" class="btn btn-primary">Add Break</a>
    </div>
</div>
