@model UniversityStudentPerformanceTracker.Models.User
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}
<style>
    body {
        background-color: #f0f0f0;
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
    }

    .dashboard-container {
        max-width: 800px;
        margin: 20px auto;
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    h1 {
        font-size: 28px;
        color: #333;
        text-align: center;
    }

    h2 {
        font-size: 24px;
        color: #555;
        margin-top: 20px;
        border-bottom: 2px solid #ddd;
        padding-bottom: 5px;
    }

    ul {
        list-style-type: none;
        padding: 0;
    }

    li {
        margin-bottom: 10px;
    }

    button {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 10px 20px;
        cursor: pointer;
        border-radius: 5px;
        font-size: 16px;
        margin-top: 10px;
    }

    button:hover {
        background-color: #0056b3;
    }
</style>

<h1>Welcome to the Dashboard, @User.Identity.Name!</h1>

<div class="dashboard-container">
    <div>
        <p>Your user ID: @Model.UserId</p>
    </div>

    <div>
        <h2>Recent Study Sessions</h2>
        <ul>
            @foreach (var session in Model.StudySessions.OrderByDescending(s => s.Date).Take(5))
            {
                <li>@session.Subject on @session.Date.ToShortDateString(): @session.Duration minutes</li>
            }
        </ul>
        <button onclick="location.href='@Url.Action("Create", "StudySession")'">Add Study Session</button>
    </div>

    <div>
        <h2>Recent Breaks</h2>
        <ul>
            @foreach (var breakInfo in Model.Breaks.Where(b => b.UserId == Model.UserId).OrderByDescending(b => b.Date).Take(5))
            {
                <li>@breakInfo.Description on @breakInfo.Date.ToShortDateString(): @breakInfo.Duration minutes</li>
            }
        </ul>
    </div>

    <div>
        <h2>Weekly View</h2>
        <p>View your study and break schedule for the week:</p>
        <!-- Weekly schedule logic can be implemented here -->
    </div>

    <div>
        <h2>Performance Predictions</h2>
        <p>
            Predicted Grades: 
            @foreach (var subject in Model.StudySessions.Select(s => s.Subject).Distinct())
            {
                var gradePredictor = new UniversityStudentPerformanceTracker.Models.GradePredictor();
                var futureStudyHours = 10; // Example value, replace with actual logic
                var predictedGrade = gradePredictor.CalculatePredictedGrade(subject, futureStudyHours);

                <span>@subject: @predictedGrade</span><br />
            }
        </p>
    </div>

    <div>
        <h2>Reports</h2>
        <button onclick="location.href='@Url.Action("Generate", "Report")'">Generate Weekly Report</button>
    </div>
</div>
