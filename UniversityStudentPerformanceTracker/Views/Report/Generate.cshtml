@model UniversityStudentPerformanceTracker.Models.ReportViewModel
@{
    ViewData["Title"] = "Weekly Report";
    Layout = "~/Views/Shared/_LayoutAfterLogin.cshtml";
}

<div class="dashboard-container">
    <h1>Weekly Report</h1>

    <form asp-action="Generate" method="get">
        <div class="form-group">
            <label for="startDate">Start Date</label>
            <input type="date" id="startDate" name="startDate" class="form-control" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" required />
        </div>
        <div class="form-group">
            <label for="endDate">End Date</label>
            <input type="date" id="endDate" name="endDate" class="form-control" value="@Model.WeekEndDate.ToString("yyyy-MM-dd")" required />
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
    </form>

    <h2>Study Sessions from @Model.WeekStartDate.ToShortDateString() to @Model.WeekEndDate.ToShortDateString()</h2>
    @if (Model.StudySessions != null && Model.StudySessions.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Subject</th>
                    <th>Duration (Minutes)</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in Model.StudySessions)
                {
                    <tr>
                        <td>@session.Date.ToShortDateString()</td>
                        <td>@session.Subject</td>
                        <td>@session.Duration</td>
                        <td>@session.StartTime.ToShortTimeString()</td>
                        <td>@session.EndTime.ToShortTimeString()</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No study sessions found for the selected time frame.</p>
    }

    <h2>Breaks from @Model.WeekStartDate.ToShortDateString() to @Model.WeekEndDate.ToShortDateString()</h2>
    @if (Model.Breaks != null && Model.Breaks.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Duration (Minutes)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var breakSession in Model.Breaks)
                {
                    <tr>
                        <td>@breakSession.StartTime.ToShortDateString()</td>
                        <td>@breakSession.StartTime.ToShortTimeString()</td>
                        <td>@breakSession.EndTime.ToShortTimeString()</td>
                        <td>@breakSession.Duration</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No breaks found for the selected time frame.</p>
    }
</div>